# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Public address of the site. Printed into every QR code, so decide it BEFORE printing.
PUBLIC_BASE_URL=http://localhost:5173

# PostgreSQL. A trailing ?schema=public is accepted and ignored.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/smarttag

# Secrets: at least 32 random characters each (openssl rand -hex 32).
SESSION_SECRET=
OTP_SECRET=
IP_HASH_SALT=

# SMS provider: "console" prints the OTP in the API log. It is refused in production.
SMS_PROVIDER=console

# Online payment: none (cash on delivery only) or mock (a pretend provider for development).
# A real provider is added once CARTAG has a merchant account. The app refuses mock in production.
PAYMENT_PROVIDER=none

# Flat delivery charge in rupees until the real delivery pricing is decided.
SHIPPING_FEE_PKR=0

# Tag codes and print size
TAG_CODE_LENGTH=10
QR_PHYSICAL_SIZE_MM=25

# Reverse proxies in front of the app (Nginx = 1). Leave 0 when it is exposed directly.
TRUST_PROXY=0
